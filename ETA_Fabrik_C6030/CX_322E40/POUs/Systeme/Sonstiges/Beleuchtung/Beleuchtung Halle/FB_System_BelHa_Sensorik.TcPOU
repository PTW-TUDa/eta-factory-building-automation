  <POU Name="FB_System_BelHa_Sensorik" Id="{bbe167d5-f73e-45b1-afd3-42c2dd49a4fb}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_System_BelHa_Sensorik
