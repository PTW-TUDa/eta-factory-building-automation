	Zustand_Oberlichter_Halle_Stellung		 :BOOL;
	Zustand_Oberlichter_Treppenhaus_Stellung :BOOL;

END_VAR
VAR
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[Zustand_Servomotor_Fenster_O_W_auf	 		:= IN_Servomotor_Fenster_O_W_auf;
Zustand_Oberlichter_Halle_Stellung			:= IN_Oberlichter_Halle_Stellung;
