  <POU Name="FB_Fenster_Input" Id="{d5fcaa59-22ed-4b0c-8cfa-0c6c4254bfbe}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Fenster_Input
VAR_IN_OUT
