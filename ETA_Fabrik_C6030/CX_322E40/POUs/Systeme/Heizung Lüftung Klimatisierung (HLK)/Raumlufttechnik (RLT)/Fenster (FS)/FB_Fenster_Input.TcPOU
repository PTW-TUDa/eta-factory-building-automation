	Zustand_Fenster_WEST			: ST_Fenster_Zustand;


	IN_Servomotor_Fenster_O_W_auf		: BOOL;
	IN_Oberlichter_Halle_Stellung		: BOOL;
	IN_Oberlichter_Treppenhaus_Stellung	: BOOL;
	Steuerung				: ST_System_Fenster_Steuerung;
END_VAR
