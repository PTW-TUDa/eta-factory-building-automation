    <Action Name="Betrieb_8_Action" Id="{3eb0ec85-441f-4d07-9555-c773c4773f60}">
      <Implementation>
        <ST><![CDATA[(* Stellwert setzen *)
Stellwert.Anford_Stellventil_Netz	:= TRUE;
Stellwert.Anford_Pumpe_Netz	:= TRUE;
Stellwert.Anford_Stellventil		:= TRUE;
Stellwert.Anford_Pumpe		:= TRUE;
Stellwert.Anford_Regelventil		:= TRUE;

(* Zustand setzen *)
Zustand.Betrieb				:= TRUE;
Zustand.Status				:= E_System_WDT_Zustand_Status_Betrieb;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Betrieb_Sperre_9_Action" Id="{81acfcff-ee81-465e-b289-dbfdee8acc8d}">
      <Implementation>
