Stellwert.Anford_Pumpe_Netz	:= TRUE;
Stellwert.Anford_Stellventil		:= TRUE;
Stellwert.Anford_Pumpe		:= TRUE;
Stellwert.Anford_Regelventil		:= TRUE;

(* Zustand setzen *)
Zustand.Betrieb				:= TRUE;
Zustand.Status				:= E_System_WDT_Zustand_Status_Betrieb_Sperre;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Betriebsbereit_1_Action" Id="{cb883fa3-7e14-41de-bf36-b6f1ad572761}">
      <Implementation>
        <ST><![CDATA[(* Stellwert setzen *)
Stellwert.Anford_Stellventil_Netz	:= FALSE;
Stellwert.Anford_Pumpe_Netz	:= FALSE;
Stellwert.Anford_Stellventil		:= FALSE;
Stellwert.Anford_Pumpe		:= FALSE;
Stellwert.Anford_Regelventil		:= FALSE;
Stellwert.Anford_Aussenfassadenaktivierung	:= FALSE;

(* Zustand setzen *)
Zustand.Betrieb			:= FALSE;
Zustand.Status			:= E_System_WDT_Zustand_Status_Betriebsbereit;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Idle_Sperre_0_Action" Id="{5b07653e-a429-473a-bf1c-6a9aca2bc86d}">
      <Implementation>
        <ST><![CDATA[(* Stellwert setzen *)
Stellwert.Anford_Stellventil_Netz	:= FALSE;
Stellwert.Anford_Pumpe_Netz	:= FALSE;
Stellwert.Anford_Stellventil		:= FALSE;
Stellwert.Anford_Pumpe		:= FALSE;
Stellwert.Anford_Regelventil		:= FALSE;
Stellwert.Anford_Aussenfassadenaktivierung	:= FALSE;

(* Zustand setzen *)
Zustand.Betrieb			:= FALSE;
Zustand.Status			:= E_System_WDT_Zustand_Status_Idle_Sperre;

(* Quittierungszustand auf False setzen, damit das System bei einer erneuten Störung nicht direkt wieder angeschaltet wird *)
Steuerung.Quittierung	:= FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Nachlauf_Pumpe_4_Action" Id="{5a9be1fb-e3c7-49c5-8a3a-0c5de450ac59}">
      <Implementation>
        <ST><![CDATA[(* Stellwert setzen *)
Stellwert.Anford_Stellventil_Netz	:= TRUE;
Stellwert.Anford_Pumpe_Netz	:= FALSE;
Stellwert.Anford_Stellventil		:= TRUE;
Stellwert.Anford_Pumpe		:= FALSE;
Stellwert.Anford_Regelventil		:= FALSE;
Stellwert.Anford_Aussenfassadenaktivierung	:= FALSE;


(* Zustand setzen *)
Zustand.Betrieb				:= FALSE;
Zustand.Status				:= E_System_WDT_Zustand_Status_Nachl_Pumpe;
Zustand.Status_Nachl_Pumpe	:= Zustand_Pumpe.Betrieb OR Zustand_Pumpe.Status_Nachl OR (Zustand.Modus_viaNetz AND(Zustand_Pumpe_Netz.Betrieb OR Zustand_Pumpe_Netz.Status_Nachl));]]></ST>
      </Implementation>
    </Action>
    <Action Name="Nachlauf_Pumpe_4_Entry" Id="{d4efe7db-cbd7-4921-af6d-91fd60e8047d}">
      <Implementation>
        <ST><![CDATA[Zustand.Status_Nachl_Pumpe	:= TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Nachlauf_Pumpe_4_Exit" Id="{ea4a6e65-fc2c-47b1-a88e-7c8e2b718159}">
      <Implementation>
        <ST><![CDATA[Zustand.Status_Nachl_Pumpe	:= FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Nachlauf_Regelventil_6_Action" Id="{98bcbd22-3d31-4a8e-a615-710573b477a5}">
      <Implementation>
        <ST><![CDATA[(* Stellwert setzen *)
Stellwert.Anford_Stellventil_Netz	:= TRUE;
Stellwert.Anford_Pumpe_Netz	:= TRUE;
Stellwert.Anford_Stellventil		:= TRUE;
Stellwert.Anford_Pumpe		:= TRUE;
Stellwert.Anford_Regelventil		:= FALSE;
Stellwert.Anford_Aussenfassadenaktivierung	:= FALSE;


(* Zustand setzen *)
Zustand.Betrieb					:= FALSE;
Zustand.Status					:= E_System_WDT_Zustand_Status_Nachl_Regelventil;
Zustand.Status_Nachl_Regelventil	:= Zustand_Regelventil.Betrieb OR Zustand_Regelventil.Status_Nachl;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Nachlauf_Regelventil_6_Entry" Id="{7c266614-8c64-4495-ad17-7ef0b123a9c4}">
      <Implementation>
        <ST><![CDATA[Zustand.Status_Nachl_Regelventil		:= TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Nachlauf_Regelventil_6_Exit" Id="{1214f0a8-b03f-4931-a872-67901a7519fb}">
      <Implementation>
        <ST><![CDATA[Zustand.Status_Nachl_Regelventil		:= FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Nachlauf_Stellventil_2_Action" Id="{fd31c1c1-290f-4dec-970c-8e2578470e48}">
      <Implementation>
        <ST><![CDATA[(* Stellwert setzen *)
Stellwert.Anford_Stellventil_Netz	:= FALSE;
Stellwert.Anford_Pumpe_Netz	:= FALSE;
Stellwert.Anford_Stellventil		:= FALSE;
Stellwert.Anford_Pumpe		:= FALSE;
Stellwert.Anford_Regelventil		:= FALSE;
Stellwert.Anford_Aussenfassadenaktivierung	:= FALSE;


(* Zustand setzen *)
Zustand.Betrieb				:= FALSE;
Zustand.Status				:= E_System_WDT_Zustand_Status_Nachl_Stellventil;
Zustand.Status_Nachl_Stellventil :=
Zustand.Modus_viaNetz AND (
	Zustand.Modus_Heizung AND (
		Zustand_Stellventil_Netz_WW.Stellung OR Zustand_Stellventil_Netz_WW.Stellungwechsel10
	)
	OR (
		Zustand.Modus_Kuehlung AND (
			Zustand_Stellventil_Netz_KW.Stellung OR Zustand_Stellventil_Netz_KW.Stellungwechsel10
		)
	)
);
]]></ST>
      </Implementation>
    </Action>
    <Action Name="Nachlauf_Stellventil_2_Entry" Id="{25763129-3e8c-4288-a373-999cbe9c4772}">
      <Implementation>
        <ST><![CDATA[Zustand.Status_Nachl_Stellventil	:= TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Nachlauf_Stellventil_2_Exit" Id="{dd677da1-ef49-479a-bf00-be0cba550a0c}">
      <Implementation>
        <ST><![CDATA[Zustand.Status_Nachl_Stellventil	:= FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Stoerung_99_Action" Id="{5d0b2f04-d734-46d6-8323-3fcbfa937bd4}">
      <Implementation>
        <ST><![CDATA[(* Stellwert setzen *)
Stellwert.Anford_Stellventil_Netz	:= FALSE;
Stellwert.Anford_Pumpe_Netz	:= FALSE;
Stellwert.Anford_Stellventil		:= FALSE;
Stellwert.Anford_Pumpe		:= FALSE;
Stellwert.Anford_Regelventil		:= FALSE;
Stellwert.Anford_Aussenfassadenaktivierung	:= FALSE;

(* Zustand setzen *)
Zustand.Betrieb			:= FALSE;
Zustand.Stoerung			:= TRUE;
Zustand.Status			:= E_System_WDT_Zustand_Status_Stoerung;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Stoerung_99_Exit" Id="{9c6b46f9-9356-432e-b62a-73629a8824d5}">
      <Implementation>
        <ST><![CDATA[Zustand.Stoerung	:= FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Vorlauf_Pumpe_5_Action" Id="{ac55b952-3260-4f1f-8530-1e8ebf187c42}">
      <Implementation>
        <ST><![CDATA[(* Stellwert setzen *)
Stellwert.Anford_Stellventil_Netz	:= TRUE;
Stellwert.Anford_Pumpe_Netz	:= TRUE;
Stellwert.Anford_Stellventil		:= TRUE;
Stellwert.Anford_Pumpe		:= TRUE;
Stellwert.Anford_Regelventil		:= FALSE;
Stellwert.Anford_Aussenfassadenaktivierung	:= FALSE;


(* Zustand setzen *)
Zustand.Betrieb				:= FALSE;
Zustand.Status				:= E_System_WDT_Zustand_Status_Vorl_Pumpe;
Zustand.Status_Vorl_Pumpe	:=
NOT(
	Zustand_Pumpe.Betrieb AND NOT Zustand_Pumpe.Status_Vorl
)
OR
(
	Zustand.Modus_viaNetz AND NOT(
		Zustand_Pumpe_Netz.Betrieb AND NOT Zustand_Pumpe_Netz.Status_Vorl
	)
)
;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Vorlauf_Pumpe_5_Entry" Id="{b1893d7d-7bca-43b3-a65a-8ccab83fc8d7}">
      <Implementation>
        <ST><![CDATA[Zustand.Status_Vorl_Pumpe	:= TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Vorlauf_Pumpe_5_Exit" Id="{0f4504f3-4d9f-4bcd-b193-74283f99934a}">
      <Implementation>
        <ST><![CDATA[Zustand.Status_Vorl_Pumpe	:= FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Vorlauf_Regelventil_7_Action" Id="{e68c7193-da43-4353-b10d-9ef60549c5d5}">
      <Implementation>
        <ST><![CDATA[(* Stellwert setzen *)
Stellwert.Anford_Stellventil_Netz	:= TRUE;
Stellwert.Anford_Pumpe_Netz	:= TRUE;
Stellwert.Anford_Stellventil		:= TRUE;
Stellwert.Anford_Pumpe		:= TRUE;
Stellwert.Anford_Regelventil		:= TRUE;


(* Zustand setzen *)
Zustand.Betrieb				:= FALSE;
Zustand.Status				:= E_System_WDT_Zustand_Status_Vorl_Regelventil;
Zustand.Status_Vorl_Regelventil	:= NOT(Zustand_Regelventil.Betrieb AND NOT Zustand_Regelventil.Status_Vorl);]]></ST>
      </Implementation>
    </Action>
    <Action Name="Vorlauf_Regelventil_7_Entry" Id="{08c9e90f-b979-4c70-89e1-ba1e1af31dd9}">
      <Implementation>
        <ST><![CDATA[Zustand.Status_Vorl_Regelventil	:= TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Vorlauf_Regelventil_7_Exit" Id="{e6c394b9-fd71-4734-b616-abc6a42837b3}">
      <Implementation>
        <ST><![CDATA[Zustand.Status_Vorl_Regelventil		:= FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Vorlauf_Stellventil_3_Action" Id="{aa99ae5b-40a1-4d68-82cb-1fb0e0980676}">
      <Implementation>
        <ST><![CDATA[(* Stellwert setzen *)
Stellwert.Anford_Stellventil_Netz	:= TRUE;
Stellwert.Anford_Pumpe_Netz	:= FALSE;
Stellwert.Anford_Stellventil		:= TRUE;
Stellwert.Anford_Pumpe		:= FALSE;
Stellwert.Anford_Regelventil		:= FALSE;
Stellwert.Anford_Aussenfassadenaktivierung	:= FALSE;


(* Zustand setzen *)
Zustand.Betrieb				:= FALSE;
Zustand.Status				:= E_System_WDT_Zustand_Status_Vorl_Stellventil;
Zustand.Status_Vorl_Stellventil	:=
(
	Zustand.Modus_viaNetz AND
	(
		(
		Zustand.Modus_Heizung AND NOT Zustand_Stellventil_Netz_WW.Stellung AND Zustand_Stellventil_Netz_WW.Stellungwechsel01
		)
		OR
		(
		Zustand.Modus_Kuehlung AND NOT Zustand_Stellventil_Netz_KW.Stellung AND Zustand_Stellventil_Netz_KW.Stellungwechsel01
		)
	)
)
OR
(
	Zustand.Modus_viaAussenfassade AND NOT Zustand_Stellventil_AFA.Stellungrueckmeldung1_505
);]]></ST>
      </Implementation>
    </Action>
    <Action Name="Vorlauf_Stellventil_3_Entry" Id="{a602fa8a-e61c-4a49-ab40-dc2cf5ca13a4}">
      <Implementation>
        <ST><![CDATA[Zustand.Status_Vorl_Stellventil	:= TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Vorlauf_Stellventil_3_Exit" Id="{8eaf671d-7e90-4b36-a26e-3020f005aea5}">
      <Implementation>
        <ST><![CDATA[Zustand.Status_Vorl_Stellventil	:= FALSE;]]></ST>
      </Implementation>
    </Action>
