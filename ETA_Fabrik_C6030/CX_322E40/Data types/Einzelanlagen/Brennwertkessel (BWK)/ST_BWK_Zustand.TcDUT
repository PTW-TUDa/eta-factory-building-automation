  <DUT Name="ST_BWK_Zustand" Id="{977fd29e-de60-469a-8d9f-8500d1115ef1}">
    <Declaration><![CDATA[TYPE ST_BWK_Zustand :
STRUCT
	Betrieb_Anford		: BOOL;
	Betrieb_Soll		: BOOL;
	Betrieb				: BOOL;

	Regelung_Modus		: SINT;
	Regelung_Istw		: REAL;
	Regelung_Sollw		: REAL;

	Leistung			: SINT;	(* 0..100 % *)
	Temp_Ist			: REAL;
	Temp_Soll			: REAL;
	Temp_Soll_aus_BWK	: REAL;

	Freigabe			: BOOL;
	Freigabe_Deakt		: BOOL;
	Freigabe_Code		: WORD;

	Kommunikation		: BOOL;

	Stoerung			: BOOL;
	Stoerung_Code		: WORD;

	Warnung				: BOOL;
	Warnung_Code		: WORD;

	Status				: SINT;

	Status_BWK			: INT;
	Alarm				: INT;
	Aussentemperatur	: REAL;
	Temp_Vorlauf		: REAL;

	Status_Vorl			: BOOL;
	Status_Nachl		: BOOL;

	Quittierung			: BOOL;

	Status_Code1		: INT;	(* Zustand Statuscode Status Reglerausgaenge, Bedeutung s. Datenblatt *)
	Status_Code2		: INT;	(* Zustand Statuscode Aktueller Betriebsstatus der Heizkreisregelung Bedeutung s. Datenblatt *)

END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
