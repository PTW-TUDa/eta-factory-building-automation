  <DUT Name="ST_BHKW_Zustand" Id="{f4cd2b12-c7af-407a-a029-c0917f6b224d}">
    <Declaration><![CDATA[TYPE ST_BHKW_Zustand :
STRUCT
	Betrieb_Anford		: BOOL;
	Betrieb_Soll		: BOOL;
