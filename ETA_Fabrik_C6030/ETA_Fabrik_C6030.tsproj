	<Translations>
		<Text TxtId="NewEventClass_DisplayText"/>
		<Text TxtId="Terminal &quot;{0}&quot; has active messages!"/>
		<Text TxtId="There are no active Messages!"/>
		<Text TxtId="On terminal {0} a limit check on Ch {1} failed: {2}."/>
		<Text TxtId="On terminal {0} a value on Ch {1} did not change within a specified time."/>
		<Text TxtId="On terminal {0} says: {1}"/>
		<Text TxtId="On terminal {0} the slave {1} reports: {2}."/>
		<Text TxtId="On terminal {0} the Ch {1} has an {2} error."/>
