<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <DUT Name="ST_PU_les_Zustand" Id="{975d83cb-51bc-4603-ad1e-bf43cf8c1e92}">
    <Declaration><![CDATA[TYPE ST_PU_les_Zustand :
STRUCT
	Betrieb	: BOOL;
	Freigabe	: BOOL;
	Stoerung	: BOOL;
	Kommunikation		: BOOL;

	Leistung				: REAL;	(* 0..100 % *)

	Leistung_elek			: REAL;	(* W *)
	Leistung_therm		: REAL;	(* W *)
	Druckdifferenz		: REAL;
	Energie_elek			: REAL;
	Energie_therm		: REAL;
	Volumenstrom		: REAL;
	Volumenstrom_intern	: REAL;
	Volumen				: REAL;
	Temp_intern			: REAL;
	Temp_extern			: REAL;
	Temp_elek			: REAL;
	Drehzahl				: REAL;	(* U/min *)
	Frequenz_Motor		: REAL;	(* Hz *)
	Zeit_Betrieb			: REAL;	(* h *)
	Anzahl_Starts			: REAL;
	Modul_Status			: WORD;	(* StatusModule, Byte 1 + Byte 2 *)
	Modul_Regelungsart	: USINT;	(* StatusModule, Byte 5 *)
	Modul_Betriebsart		: USINT; (* StatusModule, Byte 6 *)
	Modul_Meld_Code1	: WORD;
	Modul_Meld_Code2	: WORD;

END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>