  <DUT Name="ST_OPCUA_Node_REAL" Id="{7171cc78-43b3-4557-bfdb-c494b03f047d}">
    <Declaration><![CDATA[TYPE ST_OPCUA_Node_REAL :
STRUCT
	NodeID				: ST_UANodeID := ( eIdentifierType	:= eUAIdentifierType_String);
	NodeHdl				: DWORD;
	SizeOfDataType		: UDINT := 4;
	NodeAddInfo			: ST_UANodeAdditionalInfo := (	nIndexRangeCount			:= 0(*,
													stIndexRange[1].nStartIndex 	:= 0,
													stIndexRange[1].nEndIndex 		:= 1*));
	TargetVar			: POINTER TO REAL;
END_STRUCT
END_TYPE]]></Declaration>
