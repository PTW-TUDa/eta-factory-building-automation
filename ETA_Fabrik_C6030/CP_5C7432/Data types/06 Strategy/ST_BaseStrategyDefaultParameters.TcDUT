<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.10">
  <DUT Name="ST_BaseStrategyDefaultParameters" Id="{630dbe9b-22aa-47bc-b8cf-4f1da4ac5818}">
    <Declaration><![CDATA[TYPE ST_BaseStrategyDefaultParameters :
STRUCT
	//target temperatures for building mode
	fTargetTemperature_HNHT : REAL := 55;
	fTargetTemperature_HNLT_Cooling : REAL := 45;
	fTargetTemperature_HNLT_Heating : REAL := 40;
	fTargetTemperature_CN : REAL := 15;
	
	//temperature limits for thermal networks in building mode
	aTemperatureLimits_HNHT : ARRAY[1..2] OF REAL := [50,70];
	aTemperatureLimits_HNLT : ARRAY[1..2] OF REAL := [30,50];
	aTemperatureLimits_CN : ARRAY[1..2] OF REAL := [10,20];	

	//target temperatures for production mode
	fTargetTemperature_HNHT_ProductionMode : REAL := 70;
	fTargetTemperature_HNLT_Cooling_ProductionMode : REAL := 40;
	fTargetTemperature_HNLT_Heating_ProductionMode : REAL := 35;
	fTargetTemperature_CN_ProductionMode : REAL := 15;
		
	//temperature for thermal networks in production mode
	aTemperatureLimits_HNHT_ProductionMode : ARRAY[1..2] OF REAL := [65,85];
	aTemperatureLimits_HNLT_ProductionMode : ARRAY[1..2] OF REAL := [10,40];
	aTemperatureLimits_CN_ProductionMode : ARRAY[1..2] OF REAL := [10,20];
	
	//offset between target and feed temperatures
	fOffset_FeedTemperature_HNHT : REAL := 4;
	fOffset_FeedTemperature_HNLT_Heating : REAL := 2;
	fOffset_FeedTemperature_HNLT_Cooling : REAL := 2;
	fOffset_FeedTemperature_CN : REAL := 0;
	
	fTargetTemperature_ProductionHall : REAL := 19;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>