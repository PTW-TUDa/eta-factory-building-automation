<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.10">
  <GVL Name="Global_Variables" Id="{7f5eddb1-d55e-4a81-adf4-e98316ed376c}">
    <Declaration><![CDATA[{attribute 'Tc2GvlVarNames'}
VAR_GLOBAL
	GA_Allgemein 	: FB_GA_Allgemein;
	{attribute 'OPC.UA.DA' := '1'} GA_global		: ST_GA_global;		

	Beleuchtung					: FB_Beleuchtung;
	Zaehler						: FB_ZAE;


	Dali_K522A1_DALI_IN		 	AT %I* : ST_DALIV2InData;	(*~ Eingangspuffer für Dali Klemme *)
	Dali_K522A1_DALI_OUT 		AT %Q* : ST_DALIV2OutData;	(*~ Ausgangspuffer für Dali Klemme *)

	Initialisierung				: ST_Initialisierungsroutine;
	Initialisierungsroutine	: FB_Initialisierungsroutine;

END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>