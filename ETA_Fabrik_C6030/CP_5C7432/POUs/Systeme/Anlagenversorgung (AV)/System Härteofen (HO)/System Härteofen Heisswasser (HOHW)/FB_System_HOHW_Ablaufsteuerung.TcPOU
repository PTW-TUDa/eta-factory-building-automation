    <Action Name="Betrieb_8_Action" Id="{0a697c78-afed-482f-8628-a69b6d71bd25}">
      <Implementation>
        <ST><![CDATA[(* Stellwert setzen *)
Stellwert.Anford_Stellventil	:= TRUE;
Stellwert.Anford_Pumpe	:= TRUE;
Stellwert.Freigabe_Anlage	:= TRUE;

(* Zustand setzen *)
Zustand.Status				:= E_System_HO_Zustand_Status_Betrieb;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Betrieb_Sperre_9_Action" Id="{b7c521da-35b9-4ac8-9d20-cafc54a3ca59}">
      <Implementation>
        <ST><![CDATA[(* Stellwert setzen *)
Stellwert.Anford_Stellventil	:= TRUE;
Stellwert.Anford_Pumpe	:= TRUE;
Stellwert.Freigabe_Anlage	:= TRUE;

(* Zustand setzen *)
Zustand.Status				:= E_System_HO_Zustand_Status_Betrieb_Sperre;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Betriebsbereit_1_Action" Id="{34a0fb91-35af-481a-900b-3db6e7a8625b}">
      <Implementation>
        <ST><![CDATA[(* Stellwert setzen *)
Stellwert.Anford_Stellventil	:= FALSE;
Stellwert.Anford_Pumpe	:= FALSE;
Stellwert.Freigabe_Anlage	:= FALSE;

(* Zustand setzen *)
Zustand.Status			:= E_System_HO_Zustand_Status_Betriebsbereit;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Idle_Sperre_0_Action" Id="{7c751a14-c4e3-4400-bd15-993acd299bb3}">
      <Implementation>
        <ST><![CDATA[(* Stellwert setzen *)
Stellwert.Anford_Stellventil	:= FALSE;
Stellwert.Anford_Pumpe	:= FALSE;
Stellwert.Freigabe_Anlage	:= FALSE;

(* Zustand setzen *)
Zustand.Status			:= E_System_HO_Zustand_Status_Idle_Sperre;

(* Quittierungszustand auf False setzen, damit das System bei einer erneuten Störung nicht direkt wieder angeschaltet wird *)
Steuerung.Quittierung	:= FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Nachlauf_Pumpe_4_Action" Id="{710dd306-8846-4b23-a5b3-26be276211c6}">
      <Implementation>
        <ST><![CDATA[(* Stellwert setzen *)
Stellwert.Anford_Stellventil	:= TRUE;
Stellwert.Anford_Pumpe	:= FALSE;
Stellwert.Freigabe_Anlage	:= FALSE;

(* Zustand setzen *)
Zustand.Status				:= E_System_HO_Zustand_Status_Nachl_Pumpe;
Zustand.Status_Nachl_Pumpe	:= Zustand_Pumpe.Betrieb OR Zustand_Pumpe.Status_Nachl;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Nachlauf_Pumpe_4_Entry" Id="{92aab707-8f99-4149-b2a1-8fb42d01333d}">
      <Implementation>
        <ST><![CDATA[Zustand.Status_Nachl_Pumpe	:= TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Nachlauf_Pumpe_4_Exit" Id="{1702cd00-fc04-45d8-a43b-5056386f696a}">
      <Implementation>
        <ST><![CDATA[Zustand.Status_Nachl_Pumpe	:= FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Nachlauf_Stellventil_2_Action" Id="{e66c597e-4803-4267-aa6d-7386331df9cd}">
      <Implementation>
        <ST><![CDATA[(* Stellwert setzen *)
Stellwert.Anford_Stellventil	:= FALSE;
Stellwert.Anford_Pumpe	:= FALSE;
Stellwert.Freigabe_Anlage	:= FALSE;

(* Zustand setzen *)
Zustand.Status				:= E_System_HO_Zustand_Status_Nachl_Regelventil;
Zustand.Status_Nachl_Regelventil	:= Zustand_Regelventil.Betrieb OR Zustand_Regelventil.Status_Nachl;]]></ST>
      </Implementation>
    </Action>
