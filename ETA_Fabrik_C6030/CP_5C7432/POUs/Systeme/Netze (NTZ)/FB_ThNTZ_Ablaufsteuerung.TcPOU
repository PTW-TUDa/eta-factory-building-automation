    <Action Name="Betrieb_8_Action" Id="{4b3eccf6-ea2b-4385-b577-d4337e2544ac}">
      <Implementation>
        <ST><![CDATA[(* Stellwert setzen *)
Stellwert.Betrieb				:= TRUE;
Zustand.Betrieb				:= TRUE;

(* Zustand setzen *)
Zustand.Status				:= E_ThNTZ_Zustand_Status_Betrieb;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Betrieb_Sperre_9_Action" Id="{6b688bb6-c72f-4e00-baa2-337b22e952a5}">
      <Implementation>
        <ST><![CDATA[(* Stellwert setzen *)
Stellwert.Betrieb				:= TRUE;
Zustand.Betrieb				:= TRUE;

(* Zustand setzen *)
Zustand.Status				:= E_ThNTZ_Zustand_Status_Betrieb_Sperre;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Betriebsbereit_1_Action" Id="{323e29da-57eb-429a-bcb4-4c970175ee8a}">
      <Implementation>
        <ST><![CDATA[(* Stellwert setzen *)
Stellwert.Betrieb		:= FALSE;
Zustand.Betrieb		:= FALSE;

(* Zustand setzen *)
Zustand.Status			:= E_ThNTZ_Zustand_Status_Betriebsbereit;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Idle_Sperre_0_Action" Id="{b8bab1d3-9925-47c2-8c5e-167095a2fbb6}">
      <Implementation>
        <ST><![CDATA[(* Stellwert setzen *)
Stellwert.Betrieb		:= FALSE;
Zustand.Betrieb		:= FALSE;

(* Zustand setzen *)
Zustand.Status				:= E_ThNTZ_Zustand_Status_Idle_Sperre;

(* Quittierungszustand auf False setzen, damit das System bei einer erneuten Störung nicht direkt wieder angeschaltet wird *)
Steuerung.Quittierung	:= FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Stoerung_99_Action" Id="{952f8c1b-868c-496b-b5f1-9bdf210075ac}">
      <Implementation>
        <ST><![CDATA[(* Stellwert setzen *)
Stellwert.Betrieb			:= FALSE;
Zustand.Betrieb			:= FALSE;

(* Zustand setzen *)
Zustand.Stoerung			:= TRUE;
Zustand.Status			:= E_ThNTZ_Zustand_Status_Stoerung;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Stoerung_99_Exit" Id="{1ff0c11b-a938-422b-b364-508be066d44f}">
      <Implementation>
        <ST><![CDATA[Zustand.Stoerung	:= FALSE;]]></ST>
      </Implementation>
    </Action>
