<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_MBus_KL6781" Id="{f6fc5d38-386c-4eba-8b64-e6b6567e6f0d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MBus_KL6781 
VAR_INPUT
	sTerminalName		: STRING;
	sChannel			: STRING;
	fbTcMessage 		: REFERENCE TO FB_TcMessage;
	bError : BOOL;
	eError : E_MBUS_ERROR;
	bEnable: BOOL;
END_VAR
VAR_OUTPUT
	bActiveError : BOOL;
END_VAR
VAR
	sErrorString	: STRING;
	hr				: Tc3_Module.HRESULT;
	hrLastError		: Tc3_Module.HRESULT;
	fb_rtrig		: R_TRIG;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bEnable THEN
	bActiveError := FALSE;
	fb_rtrig(CLK:= bActiveError);
	RETURN;
END_IF

IF bError THEN
	bActiveError := TRUE;
	sErrorString := TO_STRING(E_MBUS_ERROR);
ELSE 
	bActiveError := FALSE;
	sErrorString := '';
END_IF

fb_rtrig(CLK:= bActiveError);

IF fb_rtrig.Q THEN
	hr := fbTcMessage.CreateEx(TC_EVENTS.ETAMessageEvents.HW_KL6731, 0);
	IF FAILED(hr) THEN
		hrLastError :=hr;
	ELSE
		fbTcMessage.ipArguments.Clear().AddString(sTerminalName).AddString(sChannel).AddString(sErrorString); 
		fbTcMessage.Send();
	END_IF
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>