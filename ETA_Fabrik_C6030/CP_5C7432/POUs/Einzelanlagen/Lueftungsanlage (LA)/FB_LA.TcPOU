<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="FB_LA" Id="{442c14cb-3717-40f4-8c74-0f30a04ba883}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LA
VAR_INPUT

	Modbus_LA		: BOOL;
END_VAR
VAR_IN_OUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
(*Diagnose-Funktion stellt eine Reihe von Tests für die Überprüfung des Übertragungssystems zwischen dem Master und dem Slave,
oder für die Überprüfung der verschiedenen internen Fehlerzustände innerhalb des Slaves, zur Verfügung.*)
	LA_955_Diagnose	: FB_MBDiagnose;
	IPAddr	 		: STRING(15);(* IPv4 address of the target device *)
	TCPPort			: UINT:= MODBUS_TCP_PORT;(* Port number of the target device *)
	UnitID			: BYTE:=16#FF;(* Identification number of a serial sub-network device *)
	WriteData		: WORD;
	Execute			: BOOL;(* Rising edge at this input starts command execution *)
	Timeout			: TIME;
	SubFnc			: WORD;
	Diagnose		: BOOL;
	Diagnose_busy	: BOOL;
	Diagnose_Error	: BOOL;
	Diagnose_ErrorID: UDINT;
	Read_Data		: WORD;

(* FB_MBReadRegs*)
	(* Read 1..128 input registers (word access) *)
	LA_955_ReadRegs		: FB_MBReadRegs;
	DestAddrRR			: PVOID;(* Pointer to destination buffer *)
	LA955_RR_arrData	: ARRAY [1..26] OF INT;
	ReadRegsBusy_Modus	: BOOL;
	ReadRegsError_Modus	: BOOL;
	ReadRegsErrID_Modus	: UDINT;
	ReadRegsCount_Modus	: UDINT;

(* FB_MBReadInputs *)
	LA_955_ReadInputs		: FB_MBReadInputs;
	ReadInputsBusy_Modus	: BOOL;
	ReadInputs_Error_Modus	: BOOL;
	ReadInputsErrID_Modus	: UDINT;
	ReadInputsCount_Modus	: UDINT;
	LA955_RI_arrData		: ARRAY [1..31] OF BYTE;
	DestAddrInputs			: PVOID;(* Pointer to destination buffer *)

(* FB_MBWriteRegs *)
	LA_955_WriteRegs		: FB_MBWriteRegs;
	WriteRegsBusy_Modus		: BOOL;
	WriteRegs_Error_Modus	: BOOL;
	WriteRegsErrID_Modus	: UDINT;
    LA955_WR_arrData		: ARRAY [1..43] OF INT;
	SrcAddrWR				: PVOID;(* Pointer to source buffer *)

(* FB_MBWritecoils / Coils = einzelner Ein-/ausgang *)
	LA_955_WriteCoils		: FB_MBWriteCoils;
	WriteCoilsBusy_Modus	: BOOL;
	WriteCoils_Error_Modus	: BOOL;
	WriteCoilsErrID_Modus	: UDINT;
    LA955_WC_arrData		: ARRAY [1..42] OF BYTE;
	SrcAddrWC				: PVOID;(* Pointer to source buffer *)

	Aktivieren5			: BOOL;
	Aktivieren6			: BOOL;
	Ablufttemp			: REAL;

(* Blinker *)
	Blinker_Abfrage		: BOOL;
	T_on				: TIME:=t#2s;
	T_off				: TIME:=t#1s;
	Timer1				: TON;
	Timer2				: TON;

	{attribute 'OPC.UA.DA' := '1'}Steuerung		: ST_LA_Steuerung; 
	{attribute 'OPC.UA.DA' := '1'}Parameter		: ST_LA_Parameter; 
	{attribute 'OPC.UA.DA' := '1'}Stellwert		: ST_LA_Stellwert; 
	{attribute 'OPC.UA.DA' := '1'}Zustand			: ST_LA_Zustand;
	Zustandscheck	: FB_LA_Zustandscheck;
END_VAR]]></Declaration>
