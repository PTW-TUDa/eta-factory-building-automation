  <POU Name="FB_BHKW" Id="{6299133a-97c8-4146-a814-0e07582dc10a}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_BHKW
VAR
	Zustandscheck: FB_BHKW_Zustandscheck;
	Logik: FB_BHKW_Logik;
	Ablaufsteuerung: FB_BHKW_Ablaufsteuerung;
	Sollwertscheck: FB_BHKW_Sollwertscheck;
	Regelung: FB_BHKW_Regelung;
	Stellwertscheck: FB_BHKW_Stellwertscheck;
	QuitTrig: FB_SetResetFallTrigger;
	SchreibeDaten: FB_BHKW_Output;
	IN_Sammelstoerung AT %I* : BOOL;
	OUT_Betrieb AT %Q* : BOOL;
	OUT_Leistung AT %Q* : INT;
	LeseDaten: FB_BHKW_Modbus;
	Timer_freigabe: TOF;
END_VAR
VAR_INPUT
	Freigabe_auto: BOOL;
	Freigabe_Deakt_auto: BOOL;
	Betrieb_Anford_auto: BOOL;
	Regelung_Modus_auto: SINT;
	Regelung_Sollw_auto: REAL;
	Quittierung: BOOL;
	Adresse: STRING(15); (* IPv4 address of the target device *)
	BHKW_1_2: BOOL; (* False = BHKW1, True = BHKW2 *)
	Parameter_init: ST_BHKW_Parameter;
	Zustand_Pumpe: ST_PU_Zustand; (* Zustände der Pumpe auslesen, da Kommunikationsmodul nicht funktional *)
END_VAR
VAR_OUTPUT
	{attribute 'OPC.UA.DA' := '1'}Steuerung: ST_BHKW_Steuerung;
	{attribute 'OPC.UA.DA' := '1'}Stellwert: ST_BHKW_Stellwert;
	{attribute 'OPC.UA.DA' := '1'}Zustand: ST_BHKW_Zustand; 
	{attribute 'OPC.UA.DA' := '1'}Parameter: ST_BHKW_Parameter;
END_VAR
]]></Declaration>
