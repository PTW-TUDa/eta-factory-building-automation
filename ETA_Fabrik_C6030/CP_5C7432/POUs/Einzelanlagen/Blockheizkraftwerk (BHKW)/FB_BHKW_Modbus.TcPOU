<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.10">
  <POU Name="FB_BHKW_Modbus" Id="{ce409556-6322-464d-af4b-a0615e9e20b0}" SpecialFunc="None">
    <Declaration><![CDATA[
FUNCTION_BLOCK FB_BHKW_Modbus
VAR_INPUT
	Adresse				: STRING(15); (* IPv4 address of the target device *)
	BHKW_1_2			: BOOL; (*False = BHKW1, True = BHKW2*)
END_VAR
VAR_OUTPUT
	Zeit_Betrieb		: REAL;	(* h *)
	Zeit_bisWartung		: REAL;	(* h *)
	Temp_Abgas			: REAL;
	Temp_Schallhaube	: REAL;
	Temp_Kuehlwasser	: REAL;
	Temp_Vorlauf		: REAL;
	Temp_Ruecklauf		: REAL;
	Oeldruck			: REAL;	(* bar *)
	Anzahl_Starts		: UINT;
	Leistung_elek		: REAL;
	Drehzahl			: REAL;	(* U/min *)
	Spannung_Generator	: REAL;
	Spannung_Netz		: REAL;
	Strom_Generator		: REAL;
	Frequenz_Netz		: REAL;
	Frequenz_Generator	: REAL;
	CosPHI				: REAL;
	Modul_Modus			: UINT;	(* 0: Aus // 1: Hand // 2: Auto *)
	Modul_Status		: UINT;	(* 0: Aus // 1: Bereit // 2: Start // 3: Betrieb // 4: Störung *)
	Modul_Betriebsart	: UINT;	(* 0: Aus // 1: Hand // 2: Netzersatz // 3:--- // 4: Anwahl 100% // 5: Sollwert 100% *)
	Modul_Meld_Code1	: WORD;	(* Bedeutung s. Datenblatt *)
	Modul_Meld_Code2	: WORD;	(* Bedeutung s. Datenblatt *)
	Modul_Meld_Code3	: WORD;	(* Bedeutung s. Datenblatt *)
	Modul_Meld_Code4	: WORD;	(* Bedeutung s. Datenblatt *)
	Modul_Meld_Code5	: WORD;	(* Bedeutung s. Datenblatt *)
	Modul_Meld_Code6	: WORD;	(* Bedeutung s. Datenblatt *)
	Modul_Meld_Code7	: WORD;	(* Bedeutung s. Datenblatt *)
	Modul_Meld_Code8	: WORD;	(* Bedeutung s. Datenblatt *)
	bReadRegsError_Modus: BOOL;
END_VAR
VAR
	Timer1				: TON;
	Timer2				: TON;
	Timer3				: TON;
	Timer4				: TON;
	Timer5 				: TON;
	Timer6				: TON;
	Timer7				: TON;
	Blinker_Abfrage1		: BOOL;
	Blinker_Abfrage2		: BOOL;
	Blinker_Abfrage3		: BOOL;
	T_on				: TIME:=t#45s;
	T_off				: TIME:=t#10s;
	nSubFnc				: WORD;
	nWriteData			: WORD;
	bDiagnose			: BOOL;
	BHKW_Modul_Modbus: FB_MBReadRegs;
	BHKW_Diagnose		: FB_MBDiagnose;
	Modbus_arrData		: ARRAY  [0..61] OF WORD;
	bDiagnose_busy		: BOOL;
	bDiagnose_Error		: BOOL;
	nDiagnose_ErrorID	: UDINT;
	nRead_Data			: WORD;
	nReadRegsBusy_Modus	: BOOL;
	bReadRegsBusy_Modus	: BOOL;

	nReadRegsErrID_Modus	: UDINT;
	nReadRegsCount_Modus	: UDINT;


	bintest : DWORD:=2#01000010010001111111110011101111;
	realtest: REAL;
	realtest2: REAL;
END_VAR]]></Declaration>
