  <POU Name="FB_PU_191" Id="{9a4f6c8b-0e71-4dae-b5e7-3994c783107e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PU_191
VAR_IN_OUT

END_VAR
VAR_INPUT
	Freigabe_auto			: BOOL;
	Freigabe_Deakt_auto		: BOOL;
	Betrieb_Anford_auto		: BOOL;
	Regelung_Modus_auto		: SINT;
	Regelung_Sollw_auto		: REAL;
	Quittierung				: BOOL;
	Parameter_init			: ST_PU_Parameter;
END_VAR
VAR_OUTPUT
	{attribute 'OPC.UA.DA' := '1'}Parameter				: ST_PU_Parameter;				
	{attribute 'OPC.UA.DA' := '1'}Steuerung				: ST_PU_Steuerung;				
	{attribute 'OPC.UA.DA' := '1'}Stellwert				: ST_PU_Stellwert;				
	{attribute 'OPC.UA.DA' := '1'}Zustand					: ST_PU_Zustand;			

END_VAR
VAR
	Zustandscheck			: FB_PU_Zustandscheck;
	Logik					: FB_PU_Logik;
	Ablaufsteuerung			: FB_PU_191_Ablaufsteuerung;
	Sollwertscheck			: FB_PU_Sollwertscheck;
	Regelung				: FB_PU_Regelung;
	Stellwertscheck			: FB_PU_Stellwertscheck;
	QuitTrig				: FB_SetResetFallTrigger;

	StatusModul1			: DWORD;
	StatusModul2			: DWORD;
	ControlModul1			: DWORD;
	ControlModul2			: DWORD;


	LeseDaten				: FB_PU_191_Input;
	SchreibeDaten			: FB_PU_Output;

	IN_StatusModule			AT %I*: ARRAY [0..5] OF USINT;
	IN_Leistung				AT %I*: UDINT;		(* 0..100% *)

	IN_Leistung_elek		AT %I*: UDINT;	(* W *)
	IN_Leistung_therm		AT %I*: UDINT;	(* W *)
	IN_Energie_elek			AT %I*: UDINT;
	IN_Energie_therm		AT %I*: UDINT;
	IN_Volumenstrom			AT %I*: UDINT;
	IN_Volumen				AT %I*: UDINT;
	IN_Temp_intern			AT %I*: UDINT;
	IN_Temp_extern			AT %I*: UDINT;
	IN_Temp_elek			AT %I*: UDINT;
	IN_Drehzahl				AT %I*: UDINT;	(* U/min *)
	IN_Frequenz_Motor		AT %I*: UDINT;	(* Hz *)
	IN_Zeit_Betrieb			AT %I*: UDINT;		(* h *)
	IN_Anzahl_Starts		AT %I*: UDINT;
	IN_Modul_Meld_Code1		AT %I*: USINT;
	IN_Modul_Meld_Code2		AT %I*: USINT;
	IN_Druckdifferenz		AT %I*: UDINT;

	OUT_ControlModule	AT %Q*: ARRAY [0..4] OF USINT;
	Quittierer : BOOL := FALSE;
END_VAR]]></Declaration>
