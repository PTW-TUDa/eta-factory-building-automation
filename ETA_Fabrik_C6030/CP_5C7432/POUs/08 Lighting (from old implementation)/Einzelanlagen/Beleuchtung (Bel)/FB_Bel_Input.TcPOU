<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.10">
  <POU Name="FB_Bel_Input" Id="{5022a524-2b4f-41e4-9900-bffef008928c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Bel_Input
VAR_INPUT
	IN_Leistung					: BYTE;
	IN_Dali_Arc_Error			: BOOL;
	IN_Dali_Off_Error			: BOOL;
	IN_Dali_Error				: BOOL;
END_VAR
VAR_OUTPUT
	Leistung					: BYTE;
	Stoerung					: BOOL;
END_VAR
VAR
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[Leistung					:=REAL_TO_BYTE((IN_Leistung-126)/1.28);
Stoerung					:=IN_Dali_Arc_Error OR IN_Dali_Arc_Error OR IN_Dali_Error;]]></ST>
    </Implementation>
    <LineIds Name="FB_Bel_Input">
      <LineId Id="13" Count="1" />
    </LineIds>
  </POU>
