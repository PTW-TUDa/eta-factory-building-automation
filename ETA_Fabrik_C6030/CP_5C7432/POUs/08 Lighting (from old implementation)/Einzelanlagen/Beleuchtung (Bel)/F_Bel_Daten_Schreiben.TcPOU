<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.10">
  <POU Name="F_Bel_Daten_Schreiben" Id="{54148966-536c-459a-a3b1-ce521bc05622}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_Bel_Daten_Schreiben : BOOL
VAR_IN_OUT
	ControlModul1	: DWORD;
	ControlModul2	: DWORD;
END_VAR
VAR_INPUT
	Zustand		: ST_PU_Zustand;
	Stellwert		: ST_PU_Stellwert;
END_VAR
VAR
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF( Stellwert.Betrieb ) THEN

	IF( Zustand.Regelung_Modus = 9) THEN
		(* dp-auto // Druckdifferenz-Auto-Adapt *)
		ControlModul1.1 := TRUE;
	ELSE
		ControlModul1.1 := FALSE;
		(* Leistungsvorgabe *)
	END_IF;
ELSE
	(* Leistungsvorgabe *)
	ControlModul1.1 := FALSE;
END_IF;]]></ST>
    </Implementation>
    <LineIds Name="F_Bel_Daten_Schreiben">
      <LineId Id="11" Count="12" />
    </LineIds>
  </POU>
</TcPlcObject>