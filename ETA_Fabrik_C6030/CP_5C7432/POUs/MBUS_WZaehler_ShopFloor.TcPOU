    <Declaration><![CDATA[PROGRAM MBUS_WZaehler_ShopFloor (* hier wird die Klemme, an welche der M-Bus mit den Zählern angeschlossen ist, alle 10ms aufgerufen *)
VAR
	Komm_Klemme_WZaehlerShopFloor	: FB_MBUSKL6781;
	WMZ1xx							: FB_MBUS_General_Ext;
	WMZ2xx							: FB_MBUS_General_Ext;
	WMZ136							: FB_MBUS_General_Ext;
	WMZ236							: FB_MBUS_General_Ext;
	WMZ436							: FB_MBUS_General_Ext;


	adrWMZ1xx			: ST_MBus_SecAdr := (udiIdNumber:=16#50951434); 
	adrWMZ2xx			: ST_MBus_SecAdr := (udiIdNumber:=16#50951428);//DC Schaltschrank
	
	adrWMZ136			: ST_MBus_SecAdr := (udiIdNumber:=16#63350363); //air heat pump CN
	adrWMZ236			: ST_MBus_SecAdr := (udiIdNumber:=16#63350367); //air heat pump HNLT
	adrWMZ436			: ST_MBus_SecAdr := (udiIdNumber:=16#63350353); //air heat pump: heat pump - buffer

END_VAR]]></Declaration>
