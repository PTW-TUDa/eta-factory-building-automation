<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.10">
  <POU Name="FB_PCMSupplySystem" Id="{341025c6-61f6-42b1-9c8c-58df0f661ef4}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PCMSupplySystem EXTENDS FB_SystemContinous
VAR_INPUT
	nControlModeAutomatic : E_PCMSystemControlMode;
	
END_VAR
VAR_OUTPUT
END_VAR
VAR
	
	{attribute 'OPC.UA.DA' := '1'}
	localSetParameters : ST_PCMSystemSetParameters;
	
	//heat meters
	WMZ900 : FB_MollineUltramess403HeatCounter; //pcm storage
	WMZ935 : FB_MollineUltramess403HeatCounter; //chiller
	
	//temperature sensors
	
	TS901 : FB_TemperatureSensor_KL3214;
	TS902 : FB_TemperatureSensor_KL3214;
	TS903 : FB_TemperatureSensor_KL3214;
	TS910 : FB_TemperatureSensor_KL3214;
	TS911 : FB_TemperatureSensor_KL3214;
	TS950 : FB_TemperatureSensor_KL3214;
	TS951 : FB_TemperatureSensor_KL3214;
	
	//valves
	ST_RV950DefaultParameters : ST_MixingValveDefaultParameters := (bFeedbackSignal := FALSE, tTaskCycleTime := GlobalVariables.tTaskCycleTime_MAIN, tCtrlCycleTime := GlobalVariables.tCtrlCycleTime_MAIN);
	RV950 : FB_MixingValve := (ST_DefaultParameters := ST_RV950DefaultParameters);
	
	// pcm chiller
	PCMChiller : FB_PCMChiller;
	
	// PCMStorage
	PCMStorage : FB_PCMStorage;
	
	//internal variables
	nControlMode : E_PCMSystemControlMode;
	
	bSetStatusOn_RV950 : BOOL; 
	
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[SelectLocalControlMode();


WMZ900(aHeatCounterTelegramm := aTelegramm_WMZ900);
WMZ935(aHeatCounterTelegramm := aTelegramm_WMZ935);
	
TS901();
TS901.GetState_AI();
TS902();
TS902.GetState_AI();
TS903();
TS903.GetState_AI();
TS910();
TS910.GetState_AI();
TS911();
TS911.GetState_AI();
TS950();
TS950.GetState_AI();
TS951();
TS951.GetState_AI();

RV950.GetState_AI();
RV950(bSetStatusOnAutomatic := bSetStatusOn_RV950,
	fSetPointAutomatic := 100,
	bAlgorithmPermission := TRUE,
	fTemperatureExternal := TS950.fTemperature,
	nControlModeAutomatic := 0);
RV950.SetState_AO();

PCMChiller.GetState(); 
PCMChiller(bSetStatusOnAutomatic := FALSE, 
	bAlgorithmPermission := bAlgorithmPermission,
	fSetPointAutomatic := fSetPoint);
PCMChiller.SetState(); ]]></ST>
    </Implementation>
    <Method Name="CheckError" Id="{8839b696-1d9b-4a95-9794-1c9ab39cf8a3}">
      <Declaration><![CDATA[METHOD PROTECTED  CheckError : BOOL
VAR_INPUT
END_VAR
