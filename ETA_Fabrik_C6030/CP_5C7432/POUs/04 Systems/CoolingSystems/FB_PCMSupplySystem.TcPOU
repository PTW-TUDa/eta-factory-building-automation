	bError : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="LocalControl" Id="{97954005-d85c-4ab5-8282-6a3311969e99}">
      <Declaration><![CDATA[METHOD LocalControl : BOOL
VAR_INPUT
	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nControlMode OF
	0: //stand-by
	PCMChiller.bStatusOn := FALSE; 
	 	
	1: //direct cooling 
	PCMChiller.nControlModeAutomatic := 0; 
	PCMChiller.fSetPointAutomatic := fSetPoint; 
	bSetStatusOn_RV950 := FALSE; 
	
	2: //charge pcm
	PCMChiller.nControlModeAutomatic := 0; 
	PCMChiller.fSetPointAutomatic := fSetPoint;
	bSetStatusOn_RV950 := TRUE; 
	
	3: //discharge pcm
	PCMChiller.nControlModeAutomatic := 1; 
	bSetStatusOn_RV950 := TRUE; 
		
END_CASE
]]></ST>
      </Implementation>
    </Method>
